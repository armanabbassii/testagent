    "item": [
      {
        "name": "Voucher lifecycle",
        "item": [
          {
            "name": "TC-001 — Create a valid voucher",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Authorization",
                  "value": "{{token}}",
                  "type": "text"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "url": {
                "raw": "{{base_url}}/api/admin/voucher",
                "host": [
                  "{{base_url}}"
                ],
                "path": [
                  "api",
                  "admin",
                  "voucher"
                ]
              },
              "description": "**Positive test case**\n\nThe voucher is created and its id is returned.",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"code\": \"SUMMER\",\n  \"discount\": 10\n}",
                "options": {
                  "raw": {
                    "language": "json"
                  }
                }
              }
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"Status code is 201\", function () {",
                    "    pm.response.to.have.status(201);",
                    "});",
                    "",
                    "pm.collectionVariables.unset(\"voucherId\");",
                    "pm.test(\"Response provides id and saves it as collection variable 'voucherId'\", function () {",
                    "    pm.expect(pm.response.code, \"HTTP status of the response that provides voucherId\").to.be.within(200, 299);",
                    "    const response = pm.response.json();",
                    "    const value = response.id;",
                    "    pm.expect(value, \"response.id\").to.not.be.oneOf([undefined, null, \"\"]);",
                    "    pm.collectionVariables.set(\"voucherId\", value);",
                    "});",
                    ""
                  ]
                }
              }
            ]
          },
          {
            "name": "TC-003 — Retrieve the created voucher",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Authorization",
                  "value": "{{token}}",
                  "type": "text"
                },
                {
                  "key": "X-Voucher-Id",
                  "value": "{{voucherId}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/api/admin/voucher/{{voucherId}}",
                "host": [
                  "{{base_url}}"
                ],
                "path": [
                  "api",
                  "admin",
                  "voucher",
                  "{{voucherId}}"
                ]
              },
              "description": "**Positive test case**\n\nThe voucher details are returned."
            },
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "{",
                    "    const value = pm.collectionVariables.get(\"voucherId\");",
                    "    const available = !(value === undefined || value === null || value === \"\");",
                    "    pm.test(\"Required collection variable 'voucherId' is available\", function () {",
                    "        pm.expect(available, \"collection variable 'voucherId' is not set — 'TC-001' must run successfully before this request.\").to.be.true;",
                    "    });",
                    "    if (!available) {",
                    "        if (pm.execution && typeof pm.execution.skipRequest === \"function\") {",
                    "            pm.execution.skipRequest();",
                    "        } else {",
                    "            throw new Error(\"collection variable 'voucherId' is not set — 'TC-001' must run successfully before this request.\");",
                    "        }",
                    "    }",
                    "}"
                  ]
                }
              },
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"Status code is 200\", function () {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    ""
                  ]
                }
              }
            ]
          },
          {
            "name": "TC-004 — Read a non-existent voucher",
