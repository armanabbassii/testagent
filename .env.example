# ===================================================
# Local LLM Configuration (OpenAI-compatible)
# ===================================================

# آدرس سرور LLM لوکال (مثلاً Ollama، LM Studio، vLLM)
LLM_BASE_URL=http://localhost:11434/v1

# نام مدل LLM (هر اسمی که سرور لوکال شما قبول می‌کنه)
LLM_MODEL=llama3.2

# API Key (برای سرورهای لوکال معمولاً هر مقداری قبوله)
LLM_API_KEY=ollama


# ===================================================
# Local Embedding Configuration (OpenAI-compatible)
# ===================================================

# آدرس سرور Embedding لوکال (می‌تونه همون LLM سرور باشه)
EMBEDDING_BASE_URL=http://localhost:11434/v1

# نام مدل Embedding
EMBEDDING_MODEL=nomic-embed-text

# API Key برای Embedding
EMBEDDING_API_KEY=ollama


# ===================================================
# Custom Required Headers
# ===================================================

# شناسه کلاینت — ثابت، از طرف سرویس‌دهنده دریافت می‌شود
CLIENT_ID=my-client-id

# توجه: USER_ID اینجا نیست — باید از کد برنامه (session/auth) پاس داده شود


# ===================================================
# GitLab Configuration
# ===================================================

# آدرس GitLab (self-hosted یا cloud)
GITLAB_URL=https://gitlab.com

# Personal Access Token با scope های: api, read_api, read_repository
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# شناسه پروژه (از Settings > General پروژه)
GITLAB_PROJECT_ID=12345678


# ===================================================
# Logging Configuration
# ===================================================

# ── General ──────────────────────────────────────
LOGGING_ENABLED=true
LOGGING_LEVEL=info
# درایور: file (فعلاً فقط file پشتیبانی می‌شود)
LOGGING_DRIVER=file

# ── File Driver ───────────────────────────────────
LOGGING_DRIVER_FILE_PATH=logs/app.log
# فرمت: text | jsonl
LOGGING_DRIVER_FILE_FORMAT=text
LOGGING_DRIVER_FILE_COLORIZE=true

# ── Per-Agent (اختیاری — ارث‌بری از global در صورت خالی بودن) ──
# LOGGING_AGENTS_CODE_REVIEWER_LEVEL=trace
# LOGGING_AGENTS_CODE_REVIEWER_ENABLED=true
# LOGGING_AGENTS_DECISION_MAKER_ENABLED=false
# LOGGING_AGENTS_GITLAB_FETCHER_LEVEL=warning



# ===================================================
# Redis Checkpointer
# ===================================================

# credentials را داخل URL قرار دهید:
#
#   بدون احراز هویت:
#   REDIS_URL=redis://localhost:6379
#
#   فقط password (legacy / Redis < 6 یا user=default):
#   REDIS_URL=redis://:mypassword@localhost:6379
#
#   username + password (Redis 6+ با ACL):
#   REDIS_URL=redis://myuser:mypassword@localhost:6379
#
#   فقط username (بدون password):
#   REDIS_URL=redis://myuser:@localhost:6379

REDIS_URL=redis://localhost:6379


# ===================================================
# Checkpointer
# ===================================================

# backend انتخابی: sqlite | redis
# - sqlite : توسعه، تست، single-node (نیازی به سرور خارجی ندارد)
# - redis  : production، multi-node
CHECKPOINTER_BACKEND=sqlite

# ── SQLite (فقط وقتی CHECKPOINTER_BACKEND=sqlite) ─────────────────────────
# مسیر فایل SQLite (":memory:" برای تست in-memory)
CHECKPOINTER_SQLITE_PATH=checkpoints.db

# ── Redis (فقط وقتی CHECKPOINTER_BACKEND=redis) ───────────────────────────
# credentials را داخل URL قرار دهید:
#   بدون احراز هویت : redis://localhost:6379
#   فقط password    : redis://:mypassword@localhost:6379
#   username + pass  : redis://myuser:mypassword@localhost:6379
# REDIS_URL=redis://localhost:6379


# ===================================================
# Custom Rules
# ===================================================

# مسیر پوشه قوانین سفارشی پروژه (پیش‌فرض: project_rules)
# RULES_DIR=project_rules


# Console Logger (وقتی LOGGING_DRIVER=console)
# LOGGING_DRIVER_CONSOLE_FORMAT=text    # text | jsonl
# LOGGING_DRIVER_CONSOLE_SHOW_TIME=false

# ===================================================
# Observability (LangFuse)
# ===================================================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000   # یا آدرس self-hosted داخل شرکت


# ===================================================
# Prompt Injection Guard
# ===================================================

# سطح محافظت: OFF | LENIENT | MODERATE | STRICT
# OFF      : غیرفعال
# LENIENT  : فقط الگوهای آشکار و خطرناک
# MODERATE : تعادل امنیت و usability (پیش‌فرض)
# STRICT   : حساس‌ترین حالت (ممکن است false positive داشته باشد)
PROMPT_GUARD_LEVEL=MODERATE

# حداکثر طول ورودی کاربر (کاراکتر) — بزرگتر truncate می‌شود (0 یا none = بدون محدودیت)
PROMPT_GUARD_MAX_INPUT_LEN=10000

# اگر true باشد، pattern های هشداری هم exception می‌اندازند
PROMPT_GUARD_RAISE_ON_WARN=false


# ===================================================
# Vector Store Backend
# ===================================================
VECTOR_STORE_BACKEND=qdrant   # یا chroma

# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# CHROMA_PERSIST_PATH=./chroma_data
# CHROMA_HOST=
# CHROMA_PORT=8000



# ===================================================
# SonarQube (اختیاری)
# ===================================================
SONAR_URL=http://localhost:9000
SONAR_TOKEN=
SONAR_SCANNER_BIN=sonar-scanner
SONAR_PROJECT_PREFIX=cr-mr
SONAR_POLL_INTERVAL_SECONDS=5
SONAR_POLL_TIMEOUT_SECONDS=600
SONAR_DELETE_PROJECT_AFTER_SCAN=true
SONAR_SCAN_MODE=diff